---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { getPublishedPosts, postHref } from '../lib/posts';
import { getYear, toISODate } from '../lib/date';

const posts = await getPublishedPosts();

const byYear = new Map<string, typeof posts>();
for (const post of posts) {
  const year = getYear(post.data.pubDate);
  const list = byYear.get(year) ?? [];
  list.push(post);
  byYear.set(year, list);
}
---

<BaseLayout title={`归档 · ${site.name}`} description="按时间归档的全部文章">
  <h1>归档</h1>
  <p>共 {posts.length} 篇</p>
  {
    [...byYear.entries()].map(([year, list]) => (
      <section>
        <h2>{year} 年</h2>
        <ul>
          {list.map((post) => (
            <li>
              <time datetime={toISODate(post.data.pubDate)}>{toISODate(post.data.pubDate)}</time>
              <a href={postHref(post)}>{post.data.title}</a>
              <span>{post.data.category}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  section {
    margin-top: var(--space-6);
  }

  h2 {
    border-bottom: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.1em;
    margin: 0;
    padding-bottom: var(--space-2);
  }

  ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  li {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0.45rem 0;
  }

  time {
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    min-width: 6.5rem;
  }

  a {
    color: var(--color-fg);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-accent);
  }

  li span {
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }
</style>
