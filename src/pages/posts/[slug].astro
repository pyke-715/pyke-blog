---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { tagHref, tagLabel, toTagSlug, type Post } from '../../lib/taxonomy';
import { formatDate, toISODate } from '../../lib/date';
import ViewCounter from '../../components/ViewCounter.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = Astro.site ?? new URL('https://example.com');
const postUrl = new URL(`/posts/${post.id}`, siteUrl).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description ?? '',
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: site.author },
  mainEntityOfPage: postUrl,
  url: postUrl,
  image: new URL('/og-default.png', siteUrl).toString(),
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout
  title={`${post.data.title} · ${site.name}`}
  description={post.data.description}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <p>
        <time datetime={toISODate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
        {' · '}
        <span>{post.data.category}</span>
        {' · '}
        {post.data.tags.map((tag, index) => (
          <Fragment>
            {index > 0 ? ' ' : ''}
            <a href={tagHref(toTagSlug(tag))}>{tagLabel(tag)}</a>
          </Fragment>
        ))}
        {post.data.updatedDate ? <Fragment>{' · '}<span>更新于 {formatDate(post.data.updatedDate)}</span></Fragment> : null}
        {' · '}
        <ViewCounter slug={post.id} />
      </p>
    </header>
    <Content />
    <Comments slug={post.id} />
    <footer>
      <p><a href="/">← 返回首页</a></p>
    </footer>
  </article>
</BaseLayout>
