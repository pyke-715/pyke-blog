---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { tagHref, tagLabel, toTagSlug, type Post } from '../../lib/taxonomy';
import { formatDate, toISODate } from '../../lib/date';
import ViewCounter from '../../components/ViewCounter.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = Astro.site ?? new URL('https://example.com');
const postUrl = new URL(`/posts/${post.id}`, siteUrl).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description ?? '',
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: site.author },
  mainEntityOfPage: postUrl,
  url: postUrl,
  image: new URL('/og-default.png', siteUrl).toString(),
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout
  title={`${post.data.title} · ${site.name}`}
  description={post.data.description}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={toISODate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
        {' · '}
        <span>{post.data.category}</span>
        {' · '}
        {post.data.tags.map((tag, index) => (
          <Fragment>
            {index > 0 ? ' ' : ''}
            <a href={tagHref(toTagSlug(tag))}>{tagLabel(tag)}</a>
          </Fragment>
        ))}
        {post.data.updatedDate ? <Fragment>{' · '}<span>更新于 {formatDate(post.data.updatedDate)}</span></Fragment> : null}
        {' · '}
        <ViewCounter slug={post.id} />
      </p>
    </header>
    <div class="post-body">
      <Content />
    </div>
    <Comments slug={post.id} />
    <footer class="post-footer">
      <a href="/">← 返回首页</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .post-header h1 {
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 var(--space-3);
  }

  .post-meta {
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .post-meta a {
    color: inherit;
    text-decoration: none;
  }

  .post-meta a:hover {
    color: var(--color-accent);
  }

  .post-footer {
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
  }

  .post-footer a {
    text-decoration: none;
  }

  .post-footer a:hover {
    text-decoration: underline;
  }
</style>
