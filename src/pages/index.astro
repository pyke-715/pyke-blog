---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { site } from '../config/site';
import { getPublishedPosts } from '../lib/posts';
import { getHeroImage } from '../lib/hero';

const posts = await getPublishedPosts();
const hero = getHeroImage(site.heroImage);
---

<BaseLayout title={site.name} description={site.description}>
  <section class:list={['hero', { 'hero--image': Boolean(hero) }]}>
    {
      hero ? (
        <Image
          src={hero}
          alt=""
          class="hero__bg"
          widths={[640, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      ) : null
    }
    <div class="hero__content">
      <h1>{site.heroTitle}</h1>
    </div>
  </section>

  <h2>最新文章</h2>
  <p>共 {posts.length} 篇</p>
  <PostList posts={posts} />
</BaseLayout>

<style is:global>
  .hero {
    position: relative;
    padding: 3rem 1rem;
  }

  .hero--image {
    color: var(--hero-fg);
  }

  .hero--image::before {
    background: var(--hero-overlay);
    content: '';
    inset: 0;
    position: absolute;
    z-index: 1;
  }

  .hero__bg {
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    width: 100%;
    z-index: 0;
  }

  .hero__content {
    position: relative;
    z-index: 2;
  }
</style>
