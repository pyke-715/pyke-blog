---
import '../styles/tokens.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import { site } from '../config/site';
import { getBackgroundImage } from '../lib/background';
import {
  DARK_THEME_ID,
  DEFAULT_THEME_ID,
  LIGHT_THEME_ID,
  STORAGE_KEY,
  SYSTEM_PREFERENCE,
  themes,
} from '../config/themes';
import ThemeStyles from '../components/ThemeStyles.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  /** 不想被搜索引擎收录的页面（如搜索结果页）传 true */
  noindex?: boolean;
  /** og:type，文章页传 article */
  type?: 'website' | 'article';
  /** 社交分享图，默认 /og-default.png */
  image?: string;
  /** 结构化数据（BlogPosting 等），传对象即可 */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  noindex = false,
  type = 'website',
  image = '/og-default.png',
  jsonLd,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site) : undefined;
const jsonLdHtml = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  return href === '/' ? pathname === '/' : pathname.startsWith(href);
}

/** 注入给客户端（防闪脚本与切换按钮共用），避免在两处重复写主题清单 */
const themeConfig = {
  storageKey: STORAGE_KEY,
  defaultId: DEFAULT_THEME_ID,
  systemId: SYSTEM_PREFERENCE,
  lightId: LIGHT_THEME_ID,
  darkId: DARK_THEME_ID,
  order: [...themes.map((theme) => theme.id), SYSTEM_PREFERENCE],
  labels: {
    ...Object.fromEntries(themes.map((theme) => [theme.id, theme.label])),
    [SYSTEM_PREFERENCE]: '跟随系统',
  },
};

const themeConfigJson = JSON.stringify(themeConfig).replace(/</g, '\\u003c');
const background = getBackgroundImage(site.backgroundImage);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage ? <meta name="twitter:image" content={ogImage} /> : null}

    {jsonLdHtml ? <script type="application/ld+json" set:html={jsonLdHtml} /> : null}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ThemeStyles />
    <script type="application/json" id="theme-config" set:html={themeConfigJson}></script>
    <script is:inline>
      (() => {
        const node = document.getElementById('theme-config');
        let config = {};
        try {
          config = JSON.parse((node && node.textContent) || '{}');
        } catch {
          config = {};
        }

        const storageKey =
          typeof config.storageKey === 'string' ? config.storageKey : 'theme-preference';
        const systemId = typeof config.systemId === 'string' ? config.systemId : 'system';
        const lightId = typeof config.lightId === 'string' ? config.lightId : 'light';
        const darkId = typeof config.darkId === 'string' ? config.darkId : 'dark';
        const order =
          Array.isArray(config.order) && config.order.length
            ? config.order
            : [lightId, darkId, systemId];
        const defaultId =
          typeof config.defaultId === 'string' && order.indexOf(config.defaultId) !== -1
            ? config.defaultId
            : order[0];

        let preference = defaultId;
        try {
          const saved = window.localStorage.getItem(storageKey);
          if (saved && (saved === systemId || order.indexOf(saved) !== -1)) preference = saved;
        } catch {
          preference = defaultId;
        }

        const resolved =
          preference === systemId
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? darkId
              : lightId
            : preference;

        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themePreference = preference;
      })();
    </script>
  </head>
  <body>
    {
      background ? (
        <div class="site-bg" aria-hidden="true">
          <Image
            src={background}
            alt=""
            widths={[1280, 1920, 2560]}
            sizes="100vw"
            loading="eager"
          />
        </div>
      ) : null
    }
    <div class="paper">
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/">{site.name}</a>
      <nav class="site-nav" aria-label="主导航">
        {
          site.nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {site.name}</p>
      {
        site.social.length > 0 ? (
          <ul>
            {site.social.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'me noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </footer>
    </div>
  </body>
</html>

<style>
  .site-bg {
    inset: 0;
    overflow: hidden;
    position: fixed;
    z-index: 0;
  }

  .site-bg img {
    height: 100%;
    object-fit: cover;
    object-position: center;
    width: 100%;
  }

  .paper {
    background-color: var(--color-bg);
    background-color: color-mix(in srgb, var(--color-bg) 86%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid var(--color-border);
    display: grid;
    grid-template-rows: auto 1fr auto;
    margin: 1.25rem auto;
    max-width: var(--page-max);
    min-height: calc(100vh - 2.5rem);
    min-height: calc(100dvh - 2.5rem);
    position: relative;
    width: calc(100% - 2rem);
    z-index: 1;
  }

  .skip-link {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    left: -9999px;
    padding: var(--space-2) var(--space-3);
    position: absolute;
    top: 0;
    z-index: 10;
  }

  .skip-link:focus {
    left: var(--space-4);
    top: var(--space-4);
  }

  .site-header {
    align-items: baseline;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-5) var(--space-5) var(--space-4);
    width: 100%;
  }

  .brand {
    color: var(--color-fg);
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-left: auto;
  }

  .site-nav a {
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--color-fg);
    text-decoration: none;
  }

  main {
    margin: 0 auto;
    max-width: var(--measure);
    padding: var(--space-7) var(--space-5) var(--space-8);
    width: 100%;
  }

  .site-footer {
    align-items: center;
    border-top: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    gap: var(--space-3) var(--space-5);
    justify-content: space-between;
    margin: 0;
    padding: var(--space-5);
    width: 100%;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer a {
    color: var(--color-fg-muted);
  }

  .site-footer a:hover {
    color: var(--color-fg);
  }

  @media (max-width: 640px) {
    .paper {
      border-left: none;
      border-right: none;
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      width: 100%;
    }

    .site-header {
      padding-bottom: var(--space-3);
    }

    .site-nav {
      gap: var(--space-3);
      margin-left: 0;
      order: 3;
      width: 100%;
    }

    main {
      padding-top: var(--space-5);
    }
  }
</style>
