---
/**
 * 主题切换按钮：单按钮三态循环（亮 → 暗 → 跟随系统 → 亮）。
 * 图标显隐完全由 <html data-theme-preference> 驱动，JS 只负责切换状态与无障碍文案。
 */
---

<button type="button" data-theme-toggle title="切换主题">
  <span class="visually-hidden" data-theme-label>主题</span>

  <svg
    class="icon icon-light"
    viewBox="0 0 24 24"
    width="17"
    height="17"
    fill="none"
    stroke="currentColor"
    stroke-width="1.45"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
    ></path>
  </svg>

  <svg
    class="icon icon-dark"
    viewBox="0 0 24 24"
    width="17"
    height="17"
    fill="none"
    stroke="currentColor"
    stroke-width="1.45"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20.5 14.2A8.6 8.6 0 0 1 9.8 3.5a8.6 8.6 0 1 0 10.7 10.7Z"></path>
  </svg>

  <svg
    class="icon icon-system"
    viewBox="0 0 24 24"
    width="17"
    height="17"
    fill="none"
    stroke="currentColor"
    stroke-width="1.45"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="8"></circle>
    <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"></path>
  </svg>
</button>

<script>
  interface ThemeConfig {
    storageKey?: string;
    defaultId?: string;
    systemId?: string;
    lightId?: string;
    darkId?: string;
    order?: string[];
    labels?: Record<string, string>;
  }

  const configNode = document.getElementById('theme-config');
  let config: ThemeConfig = {};
  try {
    config = JSON.parse(configNode?.textContent ?? '{}') as ThemeConfig;
  } catch {
    config = {};
  }

  const storageKey = config.storageKey ?? 'theme-preference';
  const systemId = config.systemId ?? 'system';
  const lightId = config.lightId ?? 'light';
  const darkId = config.darkId ?? 'dark';
  const order = config.order?.length ? config.order : [lightId, darkId, systemId];
  const labels = config.labels ?? {};
  const defaultId = config.defaultId && order.includes(config.defaultId) ? config.defaultId : order[0];

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const labelOf = (preference: string): string => labels[preference] ?? preference;
  const resolve = (preference: string): string =>
    preference === systemId ? (media.matches ? darkId : lightId) : preference;
  const nextOf = (preference: string): string => {
    const index = order.indexOf(preference);
    return order[(index + 1) % order.length] ?? order[0];
  };

  let preference = root.dataset.themePreference ?? defaultId;
  if (preference !== systemId && !order.includes(preference)) preference = defaultId;

  function render(): void {
    root.dataset.theme = resolve(preference);
    root.dataset.themePreference = preference;

    if (!button) return;
    const current = labelOf(preference);
    const next = labelOf(nextOf(preference));
    button.setAttribute('aria-label', `当前${current}，点击切换到${next}`);
  }

  render();

  button?.addEventListener('click', () => {
    preference = nextOf(preference);
    try {
      window.localStorage.setItem(storageKey, preference);
    } catch {
      // 隐私模式下写入失败时仍允许本次会话内切换
    }
    render();
  });

  media.addEventListener('change', () => {
    if (preference === systemId) render();
  });
</script>

<style>
  button {
    align-items: center;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-fg-muted);
    cursor: pointer;
    display: inline-flex;
    height: 1.85rem;
    justify-content: center;
    padding: 0;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
    width: 1.85rem;
  }

  button:hover {
    border-color: var(--color-fg-muted);
    color: var(--color-fg);
  }

  .visually-hidden {
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
</style>

<style is:global>
  [data-theme-toggle] .icon {
    display: none;
  }

  [data-theme-toggle] .icon-light {
    display: block;
  }

  html[data-theme-preference='dark'] [data-theme-toggle] .icon-light,
  html[data-theme-preference='system'] [data-theme-toggle] .icon-light {
    display: none;
  }

  html[data-theme-preference='dark'] [data-theme-toggle] .icon-dark,
  html[data-theme-preference='system'] [data-theme-toggle] .icon-system {
    display: block;
  }
</style>
