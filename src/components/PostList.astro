---
import { postHref } from '../lib/posts';
import { tagHref, tagLabel, toTagSlug, type Post } from '../lib/taxonomy';
import { formatDate, toISODate } from '../lib/date';
import ViewCounter from './ViewCounter.astro';

interface Props {
  posts: Post[];
  /** 列表里是否显示阅读量（只读，不计数） */
  showViews?: boolean;
}

const { posts, showViews = false } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <article>
          <h2>
            <a href={postHref(post)}>{post.data.title}</a>
          </h2>
          <p class="post-meta">
            <time datetime={toISODate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
            {' · '}
            <span>{post.data.category}</span>
            {' · '}
            {post.data.tags.map((tag, index) => (
              <Fragment>
                {index > 0 ? ' ' : ''}
                <a href={tagHref(toTagSlug(tag))}>{tagLabel(tag)}</a>
              </Fragment>
            ))}
            {showViews ? (
              <Fragment>
                {' · '}
                <ViewCounter slug={post.id} mode="read" />
              </Fragment>
            ) : null}
          </p>
          {post.data.description ? <p class="post-desc">{post.data.description}</p> : null}
        </article>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  article {
    border-top: 1px solid var(--color-border);
    padding: var(--space-6) 0;
  }

  li:first-child article {
    border-top: none;
    padding-top: var(--space-4);
  }

  h2 {
    font-size: clamp(1.35rem, 1.15rem + 0.9vw, 1.75rem);
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 var(--space-2);
  }

  h2 a {
    color: var(--color-fg);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-accent);
  }

  .post-meta {
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-3);
  }

  .post-meta a {
    color: inherit;
    text-decoration: none;
  }

  .post-meta a:hover {
    color: var(--color-accent);
  }

  .post-desc {
    font-size: 1rem;
    line-height: var(--leading-loose);
    margin: 0;
    opacity: 0.78;
  }
</style>
