---
import { postHref } from '../lib/posts';
import { tagHref, tagLabel, toTagSlug, type Post } from '../lib/taxonomy';
import { formatDate, toISODate } from '../lib/date';
import ViewCounter from './ViewCounter.astro';

interface Props {
  posts: Post[];
  /** 列表里是否显示阅读量（只读，不计数） */
  showViews?: boolean;
}

const { posts, showViews = false } = Astro.props;
---

<ul>
  {
    posts.map((post) => (
      <li>
        <article>
          <h2>
            <a href={postHref(post)}>{post.data.title}</a>
          </h2>
          <p>
            <time datetime={toISODate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
            {' · '}
            <span>{post.data.category}</span>
            {' · '}
            {post.data.tags.map((tag, index) => (
              <Fragment>
                {index > 0 ? ' ' : ''}
                <a href={tagHref(toTagSlug(tag))}>{tagLabel(tag)}</a>
              </Fragment>
            ))}
            {showViews ? (
              <Fragment>
                {' · '}
                <ViewCounter slug={post.id} mode="read" />
              </Fragment>
            ) : null}
          </p>
          {post.data.description ? <p>{post.data.description}</p> : null}
        </article>
      </li>
    ))
  }
</ul>
