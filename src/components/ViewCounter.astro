---
import { viewsProviderId } from '../config/views';

interface Props {
  slug: string;
  /** increment：文章页，访问即 +1；read：列表页，只读不计数 */
  mode?: 'increment' | 'read';
}

const { slug, mode = 'increment' } = Astro.props;
---

<span class="views" data-views data-slug={slug} data-provider={viewsProviderId} data-mode={mode}>
  <span class="visually-hidden">阅读</span>
  <svg
    class="views-icon"
    viewBox="0 0 24 24"
    width="15"
    height="15"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
    <circle cx="12" cy="12" r="2.6" />
  </svg>
  <span data-views-count>—</span>
</span>

<script>
  import { resolveViewsProvider } from '../lib/views';

  const nodes = document.querySelectorAll<HTMLElement>('[data-views]');

  for (const node of nodes) {
    const slug = node.dataset.slug;
    if (!slug) continue;

    const provider = resolveViewsProvider(node.dataset.provider ?? 'local');
    const target = node.querySelector<HTMLElement>('[data-views-count]');
    const action = node.dataset.mode === 'read' ? provider.get(slug) : provider.increment(slug);

    action
      .then((count) => {
        if (target) target.textContent = String(count);
      })
      .catch(() => {
        if (target) target.textContent = '—';
      });
  }
</script>

<style>
  .views {
    align-items: center;
    display: inline-flex;
    gap: 0.26em;
    vertical-align: -0.1em;
  }

  .views-icon {
    opacity: 0.8;
  }

  .visually-hidden {
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
</style>
